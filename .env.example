# ENV variables - {{TOOL_NAME}} (CapRover App Config -> Environment Variables)

# App
APP_ENV=production
APP_NAME={{TOOL_NAME}}
TOOL_SLUG={{TOOL_SLUG}}
APP_BASE_URL={{APP_BASE_URL}}
USER_MANAGEMENT_URL={{USER_MANAGEMENT_URL}}
TRUSTED_PROXIES={{TRUSTED_PROXIES}}

# Central User/Auth DB
AUTH_DB_HOST=<auth-db-hostname>
AUTH_DB_PORT=3306
AUTH_DB_NAME={{AUTH_DB_NAME}}
AUTH_DB_USER=<auth-db-user>
AUTH_DB_PASS=<auth-db-password>

# Tool-owned DB
TOOL_DB_HOST=<tool-db-hostname>
TOOL_DB_PORT=3306
TOOL_DB_NAME={{TOOL_DB_NAME}}
TOOL_DB_USER=<tool-db-user>
TOOL_DB_PASS=<tool-db-password>

# Tool access mapping in the central Auth DB
TOOL_USERS_TABLE={{TOOL_USERS_TABLE}}
TOOL_ADMIN_COLUMN={{TOOL_ADMIN_COLUMN}}

# Mail
MAIL_METHOD=smtp
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USERNAME=<smtp-user>
SMTP_PASSWORD=<smtp-password>
MAIL_FROM=no-reply@{{FULL_DOMAIN}}
MAIL_FROM_NAME={{TOOL_NAME}}

# Optional registration bot protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
